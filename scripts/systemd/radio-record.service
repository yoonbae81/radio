[Unit]
Description=Radio Recorder Service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory={{PROJECT_ROOT}}
Environment="PATH={{PROJECT_ROOT}}/.venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile={{PROJECT_ROOT}}/.env

# Check if recording is needed (lightweight bash script)
ExecStartPre={{PROJECT_ROOT}}/scripts/check-recording.sh
# If check succeeds (exit 0), run Python script for recording
ExecStart={{PROJECT_ROOT}}/.venv/bin/python {{PROJECT_ROOT}}/src/record.py

StandardOutput=journal
StandardError=journal
SyslogIdentifier=radio-record

[Install]
WantedBy=default.target
